#------------------------------------------------------------------------------
# runs the trigger reco
#------------------------------------------------------------------------------

#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"

#include "mu2e-trig-config/core/trigProducers.fcl"
#include "mu2e-trig-config/core/trigFilters.fcl"
#include "mu2e-trig-config/core/trigRecoSequences.fcl"
BEGIN_PROLOG
# Add prefetch modules to avoid reading time being added to trigger reconstruction
TrigRecoSequences.cfoDataGen : [ Prefetch, ProcessCFOData ]
END_PROLOG
#include "mu2e-trig-config/core/trigSequences.fcl"

#include "mu2e-trig-config/gen/trig_physMenuPSConfig_OnSpill.fcl"
#include "mu2e-trig-config/gen/trig_physMenu_OnSpill.fcl"

process_name : triggerTiming

# we don't need any simulation services for this job

services : @local::Services.Reco
services.GeometryService.bFieldFile     : "Offline/Mu2eG4/geom/bfgeom_reco_v01.txt"
source: { module_type: RootInput }
services.TFileService.fileName : "/dev/null"

# timing information
services.TimeTracker : {
  dbOutput : {
    filename : "triggerTiming.db" #uncomment to create the .db output
    overwrite : true
  }
}
services.scheduler.wantSummary: true

physics : {

   @table::TrigSequences
   #@table::TrigLoggerOutputs

   producers : {
       @table::TrigProducers.producers
       Prefetch : {
           module_type            : PrefetchDAQData
           fetchCaloDigis         : false
           fetchStrawDigis        : false
           fetchCaloFragments     : false
           fetchTrkFragments      : false
           fetchAllFragments      : true
           fetchEWM               : true
           fetchPBT               : true
           caloDigiCollectionTag  : "CaloDigiMaker"
           strawDigiCollectionTag : "makeSD"
           caloFragmentTag        : ""
           trkFragmentTag         : ""
           ewmTag                 : "EWMProducer"
           pbtTag                 : "EWMProducer"
           debugLevel             : 0
       }
   }
   filters   : {
      @table::TrigFilters.filters
      @table::Trig_physMenuPSConfig
  }
}

physics.trigger_paths : [@sequence::Trig_physMenu.trigger_paths]

# physics.producers.CaloHitMakerFast : { @table::TrigProducers.producers.CaloHitMakerFastFromDigi }
# physics.producers.CaloHitMakerFast.caloDigiCollection : "CaloDigiMakerFast"
physics.producers.TrigMakeSD.allowOfflineFallbackWhenPanelMapMissing : true
physics.producers.TrigMakeSD.forceOfflineAddressing : true
physics.producers.TrigMakeSD.geography : []
# #include "Production/Validation/database.fcl"
# #include "Production/JobConfig/reco/drop_trigger.fcl"

services.DbService.purpose: Sim_best
services.DbService.version: v1_4
services.DbService.verbose : 2
source.inputCommands: ["keep *",
    "drop mu2e::HelixSeed*_*_*_*",
    "drop mu2e::KalSeed*_*_*_*",
    "drop mu2e::TriggerInfo_*_*_*",
    "drop mu2e::CaloClusters_*_*_*",
    "drop mu2e::TimeClusters_*_*_*",
    "drop mu2e::CosmicTrackSeeds_*_*_*",
    "drop mu2e::IntensityInfo*_*_*_*",
    "drop mu2e::RecoCount_*_*_*",
    "drop mu2e::PrescaleFilterFraction_*_*_Digitize"  ]
