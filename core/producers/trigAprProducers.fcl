BEGIN_PROLOG

TrigAprProducers : {
  TrigTZClusterFinder : { @table::CalPatRec.producers.TZClusterFinder
    chCollLabel                : "TrigFlagPH"
    ccCollLabel                : "CaloClusterFast"
    radSelect                  : 0
    protonTCs                  : true
  }

  TrigAprHelixFinder: { @table::CalPatRec.producers.AgnosticHelixFinder
    chCollLabel             : "TrigFlagPH"
    tcCollLabel             : "TrigTZClusterFinder"
    ccCollLabel             : "CaloClusterFast"
    maxEDepAvg              : @local::TrigTrkProducers.TrigHelixFinderParams.maxEDepAvg
    maxSeedLineGap          : @local::TrigTrkConfig.Apr.HelixFinder.maxSeedLineGap
    maxNHitsRatio           : @local::TrigTrkConfig.Apr.HelixFinder.maxNHitsRatio
    minNHelixStrawHits      : @local::TrigTrkConfig.Apr.HelixFinder.minNHelixStrawHits
    minNHelixComboHits      : @local::TrigTrkConfig.Apr.HelixFinder.minNHelixComboHits
    minSeedCircleHits       : @local::TrigTrkConfig.Apr.HelixFinder.minSeedCircleHits
    minFinalSeedHits        : @local::TrigTrkConfig.Apr.HelixFinder.minFinalSeedHits
    doEDepFlag              : true
    eDepFlagThresh          : 0.003
  }

  TrigAprProtonHelixFinder: { @table::CalPatRec.producers.AgnosticHelixFinder
    chCollLabel             : "TrigFlagPH"
    tcCollLabel             : "TrigTZClusterFinder:proton"
    ccCollLabel             : "CaloClusterFast"
    minNHelixComboHits      : 10
    maxEDepAvg              : 100.
    maxNHitsRatio           : 1.5
    doEDepFlag              : false
    # heavy capture particles: the defaults (400 / 140 MeV/c) cut deuterons above KE ~ 42 MeV
    # and tritons above ~ 29 MeV (triton endpoint p ~ 640 MeV/c)
    maxHelixMomentum        : 800.
    maxHelixPerpMomentum    : 300.
  }

  TrigAprHelixMerger: {
    HelixFinders: [
      "TrigAprHelixFinder"
    ]
    debugLevel: 0
    deltanh: 5
    module_type: "MergeHelices"
    scaleXY: 1.1
    scaleZPhi: 7.5e-1
    MinHitOverlapFraction: 0.5
    MinNHitOverlap: 10
  }

  TrigAprProtonHelixMerger: {
    HelixFinders: [
      "TrigAprProtonHelixFinder"
    ]
    debugLevel: 0
    deltanh: 5
    module_type: "MergeHelices"
    scaleXY: 1.1
    scaleZPhi: 7.5e-1
    MinHitOverlapFraction: 0.5
    MinNHitOverlap: 10
  }

  TrigAprKSF: {
    module_type : LoopHelixFit
    KKFitSettings    : { @table::Mu2eKinKalTrigger.KKFIT     }
    FitSettings      : { @table::Mu2eKinKalTrigger.LHSEEDFIT }
    ExtensionSettings: { @table::Mu2eKinKalTrigger.LHSEEDEXT }
    ModuleSettings   : {
      @table::Mu2eKinKalTrigger.LHHELIX
      FitParticle : @local::Particle.eminus
      HelixSeedCollections   : [ "TrigAprHelixMerger" ]
    }
    UsePDGCharge     : false
    HelixMask: {
      MinHelixMom : 50
    }
    FitDirection     : @local::FitDir.downstream
  }

  TrigAprUeKSF: {
    module_type : LoopHelixFit
    KKFitSettings    : { @table::Mu2eKinKalTrigger.KKFIT     }
    FitSettings      : { @table::Mu2eKinKalTrigger.LHSEEDFIT }
    ExtensionSettings: { @table::Mu2eKinKalTrigger.LHSEEDEXT }
    ModuleSettings   : {
      @table::Mu2eKinKalTrigger.LHHELIX
      FitParticle : @local::Particle.eminus
      HelixSeedCollections   : [ "TrigAprHelixMerger" ]
    }
    UsePDGCharge     : false
    HelixMask: {
      MinHelixMom : 50
    }
    FitDirection     : @local::FitDir.upstream
  }

  AprTrkDe80m70pD0200TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe75m70pD0200TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe75D0200TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe70D0200TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe80m70pTriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe75m70pTriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe75TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe70TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe50D0200TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe80m70pD0200MultiTrkTriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkDe50MultiHelixTriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTrkUe80m70pTriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprHlx50Hlx30TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprHlx50TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprHlx30TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprProtonP335TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprProtonP250TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprProtonP150TriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTCTriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
  AprTCCaloTriggerInfoMerger: {
    module_type: "MergeTriggerInfo"
  }
}

END_PROLOG
