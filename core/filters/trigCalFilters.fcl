BEGIN_PROLOG

# Basic calo cluster selection, to be overriden
TrigCalClusterID : {
    CaloClusterModuleLabel: "CaloClusterFast"
    DiskID: [ 0, 1 ]
    MaxClusterEnergy: 200.
    MinClusterRadius: 0.
    MaxNCel: 20
    MinNCel: 1
    MinNCl: 1
    diagLevel: 0
    module_type: "CaloClusterCounterFilter"
}

TrigCalFilters:{
  CaloHitsPS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCsiPS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloLaserPS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCaphriPS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCosmicPS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloNNCEPS   : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloPhotonPS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloRMCPS       : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCluster50PS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCluster60PS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCluster70PS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCluster75PS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloCluster80PS    : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}
  CaloN0SourcePS : { module_type: PrescaleEvent
      eventModeConfig : [  { eventMode: OnSpill prescale:-1}, { eventMode: OffSpill prescale:-1} ]}

  CaloEventFilter: {
    module_type: "CaloEventFilter"
    debugEvery: 600000
  }

  CaloHitFilter1: {
    module_type: "CaloHitFilter"
    minimumHits: 1
    debugEvery: 600000
  }

  CaloHitFilter2: {
    module_type: "CaloHitFilter"
    minimumHits: 2
    debugEvery: 600000
  }

  CaloHitFilter10: {
    module_type: "CaloHitFilter"
    minimumHits: 10
    debugEvery: 600000
  }

  CaloHitFilterLaser: {
    module_type: "CaloHitFilter"
    minimumHits: 2500
    debugEvery: 600000
  }

  CaloLaserFilter: {
    module_type: "CaloLaserFilter"
    minimumHits: 1
    checkDiskPins: true
    debugEvery: 600000
  }

  CaloCAPHRIFilter: {
    module_type: "CaloCAPHRIFilter"
    minimumHits: 1
    debugEvery: 600000
  }

  CaloCSIFilter: {
    module_type: "CaloCSIFilter"
    minimumHits: 2
    debugEvery: 600000
  }

  CaloCosmicFilter: {
    CaloClusterModuleLabel: "CaloClusterFast"
    InnerRadius: 460
    MaxEnergy: 600
    MinCelEneCut: 12
    MinEnergy: 90
    MinNCrystalHits: 0
    MinNumCeldiagver: 6
    MinNumCelinout: 6
    OutRadius: 580
    debugLevel: 0
    diagmaxval: 2.5
    diagminval: 1.5
    dyminval: 140
    module_type: "CaloCosmicCalib"
  }


  CaloNNCEFilter: {
    caloClusterCollection: "CaloClusterFast"
    caloMVACollection:     "CaloNNCEEval"
    diagLevel: 0
    minEtoTest: 80
    maxEtoTest: 2000
    minTtoTest: 450
    maxTtoTest: 1600
    minRtoTest: 0
    maxRtoTest: 1000
    minMVAScore: 0.98
    module_type: "FilterEcalNNTrigger"
  }



  CaloPhotonFilter: {
    BackgroundTemplates: "OfflineData/CaloFilters/v7_1_5/caloLH_bkg.root"
    CaloClusterModuleLabel: "CaloClusterFast"
    ClusterEnergyStep: 10
    ClusterRadialDistStep: 50
    DropSecondDisk: false
    MinClusterEnergy: 50
    MinClusterRadialDist: 350
    MinLikelihoodCut: [
      4.144e1,
      1.036e1
    ]
    SignalTemplates: "OfflineData/CaloFilters/v7_1_5/caloLH_ce.root"
    module_type: "CaloLikelihood"
  }

  CaloCluster50Filter: {
    @table::TrigCalClusterID
    MinClusterEnergy: 50.
  }

  CaloCluster60Filter: {
    @table::TrigCalClusterID
    MinClusterEnergy: 60.
  }

  CaloCluster70Filter: {
    @table::TrigCalClusterID
    MinClusterEnergy: 70.
  }

  CaloCluster75Filter: {
    @table::TrigCalClusterID
    MinClusterEnergy: 75.
  }

  CaloCluster80Filter: {
    @table::TrigCalClusterID
    MinClusterEnergy: 80.
  }

  CaloRMCFilter: {
    CaloClusterModuleLabel: "CaloClusterFast"
    DiskID: [
      0, 1
    ]
    MaxClusterEnergy: 200
    MaxNCel: 10
    MinClusterEnergy: 80
    MinClusterRadius: 490
    MinNCel: 2
    MinNCl: 1
    diagLevel: 0
    module_type: "CaloClusterCounterFilter"
  }

  CaloN0SourceFilter: {
      caloDigiCollection: "CaloDigiMaker"
      maxCaloEnergy: -1
      maxNCaloDigi: 5000
      maxNStrawDigi: -1
      minNCaloDigi: -1
      minNStrawDigi: -1
      module_type: "DigiFilter"
      strawDigiCollection: "notUsed"
      triggerPath: "minBiasCaloDigiCount"
      useCaloDigi: true
      useStrawDigi: false
   }

}

END_PROLOG
