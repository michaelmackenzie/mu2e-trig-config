    requireCaloCluster: false
    timeClusterCollection: "TrigTZClusterFinder"
    ComboHitCollection : "TrigMakePH"
  }

  AprHlx30HSFilter: {
    helixSeedCollection: "TrigAprHelixMerger"
    module_type: "HelixFilter"
    useTrackerStatus: true
    posHelicitySelection : {
      @table::AprHelixSelections_pos
      maxAbsLambda: 1000
      maxD0: 600
      minAbsLambda: 40
      minD0: -600
      minMomentum: 30
      minNStrawHits: 20
    }
    negHelicitySelection : {
      @table::AprHelixSelections_neg
      maxAbsLambda: 1000
      maxD0: 600
      minAbsLambda: 40
      minD0: -600
      minMomentum: 30
      minNStrawHits: 20
    }
  }
  AprHlx30TCFilter: {
    minNStrawHits: 10
    module_type: "TimeClusterFilter"
    requireCaloCluster: false
    timeClusterCollection: "TrigTZClusterFinder"
    ComboHitCollection : "TrigMakePH"
  }

  # Muon capture protons and other charged capture particles (d, t, He3, alpha), in momentum bands
  # sharing TrigAprProtonHelixFinder. The protons are forward (|lambda| ~ 1000 mm). There is no
  # particle-ID cut: species are separated offline. The straw hit edep is compressed above ~4 keV
  # and capped by the ADC near 5.8 keV, and a trigger cut on the mass from p and the helix t vs z
  # slope (HelixFilter maxMass) would depend on the timing calibration.
  AprProtonP335HSFilter: { # p > 335 MeV/c (KE > ~58 MeV)
    helixSeedCollection: "TrigAprProtonHelixMerger"
    module_type: "HelixFilter"
    useTrackerStatus: true
    posHelicitySelection : {
      @table::AprProtonHelixSelection
      minMomentum: 335
    }
    negHelicitySelection : {
      @table::AprProtonHelixSelection
      minMomentum: 335
    }
  }
  AprProtonP250HSFilter: { # p > 250 MeV/c (KE > ~33 MeV), prescaled
    helixSeedCollection: "TrigAprProtonHelixMerger"
    module_type: "HelixFilter"
    useTrackerStatus: true
    posHelicitySelection : {
      @table::AprProtonHelixSelection
      minMomentum: 250
    }
    negHelicitySelection : {
      @table::AprProtonHelixSelection
      minMomentum: 250
    }
  }
  AprProtonP150HSFilter: { # p > 150 MeV/c (KE > ~12 MeV), heavily prescaled
    helixSeedCollection: "TrigAprProtonHelixMerger"
    module_type: "HelixFilter"
    useTrackerStatus: true
    posHelicitySelection : {
      @table::AprProtonHelixSelection
      minMomentum: 150
      minNStrawHits: 15
    }
    negHelicitySelection : {
      @table::AprProtonHelixSelection
      minMomentum: 150
      minNStrawHits: 15
    }
  }
  AprProtonTCFilter: {
    minNStrawHits: 10
    module_type: "TimeClusterFilter"
    requireCaloCluster: false
    timeClusterCollection: "TrigTZClusterFinder:proton"
    ComboHitCollection : "TrigMakePH"
  }

  AprTCTCFilter : {
    minNStrawHits: 15
    module_type: "TimeClusterFilter"
    requireCaloCluster: false
    timeClusterCollection: "TrigTZClusterFinder"
    ComboHitCollection : "TrigMakePH"
  }
  AprTCCaloTCFilter : {
    minNStrawHits: 15
    module_type: "TimeClusterFilter"
    requireCaloCluster: true
    timeClusterCollection: "TrigTZClusterFinder"
    ComboHitCollection : "TrigMakePH"
  }
}

END_PROLOG
