  #AprHelix filters
  AprHlx50Hlx30HSFilter: {
    helixSeedCollection: "TrigAprHelixMerger"
    module_type: "MultiHelixFilter"
    useTrackerStatus: true
    minNHelices: 2
    timeWindow : 100.
    minArcGap : 20.
    debugLevel : 0
    HelixCuts : [
      {
	minMomentum: 50
	maxMomentum: 2000
	minPt: 0
	minAbsLambda: 50
	maxAbsLambda: 500
	minNLoops: 0
	maxNLoops: 30
	minD0: -600
	maxD0:  600
	maxChi2PhiZ: 8
	maxChi2XY: 8
	minHitRatio: 0.4
	minNStrawHits: 15
      },
      {
	minMomentum: 30
	maxMomentum: 2000
	minPt: 0
	minAbsLambda: 50
	maxAbsLambda: 500
	minNLoops: 0
	maxNLoops: 30
	minD0: -600
	maxD0:  600
	maxChi2PhiZ: 8
	maxChi2XY: 8
	minHitRatio: 0.4
	minNStrawHits: 15
      }
    ]
  }
